{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prinos.schema.json",
  "title": "Личен принос",
  "description": "Текст, история или снимка с автор (псевдоним или име — по избор) и лиценз. Минава през същата опашка.",
  "type": "object",
  "additionalProperties": false,
  "required": ["vid", "rayon", "oblast", "zaglavie", "avtor", "uchastie", "sazdaden"],
  "properties": {
    "vid": {"const": "lichen_prinos"},
    "misiya_id": {"type": "string", "pattern": "^m-[a-z0-9-]+$", "maxLength": 120},
    "obekt_id": {"type": ["integer", "string"]},
    "rayon": {"type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 60},
    "oblast": {"enum": ["kultura", "sport", "turizam", "obrazovanie", "sabitiya", "npo", "msp"]},
    "zaglavie": {"type": "string", "minLength": 3, "maxLength": 120},
    "tekst": {"type": "string", "maxLength": 4000},
    "snimki": {"$ref": "snimki.schema.json"},
    "avtor": {"$ref": "avtor.schema.json"},
    "uchastie": {"$ref": "uchastie.schema.json"},
    "litsenz": {"enum": ["CC-BY-4.0", "CC0-1.0", null]},
    "s_ai": {"type": "boolean"},
    "sazdaden": {"type": "string", "format": "date"}
  }
}
