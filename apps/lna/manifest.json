{
  "manifest_version": 3,
  "name": "__MSG_ime__",
  "short_name": "ЛНА",
  "description": "__MSG_opisanie__",
  "version": "0.1.0",
  "default_locale": "bg",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "__MSG_deystvie__",
    "default_icon": { "16": "ikoni/lna-16.png", "32": "ikoni/lna-32.png", "48": "ikoni/lna-48.png" }
  },
  "side_panel": { "default_path": "src/panel.html" },
  "options_page": "src/options.html",
  "icons": { "16": "ikoni/lna-16.png", "48": "ikoni/lna-48.png", "128": "ikoni/lna-128.png" }
}
